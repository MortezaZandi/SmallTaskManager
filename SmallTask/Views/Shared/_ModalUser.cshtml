<div class="modal fade" id="modalUser" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalUserTitle">Define User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalUserId" />
                <div class="mb-2">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" id="modalUserName" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Icon path (optional)</label>
                    <input type="text" class="form-control" id="modalUserIconPath" placeholder="/images/default-avatar.png" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalUserSave">Save</button>
            </div>
        </div>
    </div>
</div>
