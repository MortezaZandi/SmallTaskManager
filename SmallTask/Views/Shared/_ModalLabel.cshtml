<div class="modal fade" id="modalLabel" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabelTitle">Define Label</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalLabelId" />
                <div class="mb-2">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" id="modalLabelName" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" id="modalLabelDescription" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Color</label>
                    <input type="color" class="form-control form-control-color" id="modalLabelColor" value="#000000" style="width:60px; height:38px;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalLabelSave">Save</button>
            </div>
        </div>
    </div>
</div>
