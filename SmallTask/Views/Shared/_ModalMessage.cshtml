<div class="modal fade" id="modalMessage" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="modalMessageHeader">
                <h5 class="modal-title" id="modalMessageTitle">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start gap-3">
                    <div id="modalMessageIcon" class="flex-shrink-0 fs-2"></div>
                    <p class="mb-0" id="modalMessageText"></p>
                </div>
            </div>
            <div class="modal-footer" id="modalMessageFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modalMessageBtnCancel" style="display:none;">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="modalMessageBtnOk">OK</button>
                <button type="button" class="btn btn-danger" id="modalMessageBtnYes" style="display:none;">Yes, delete</button>
            </div>
        </div>
    </div>
</div>
