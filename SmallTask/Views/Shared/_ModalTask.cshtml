<div class="modal fade" id="modalTask" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTaskHeader">Define Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalTaskId" />
                <div class="row mb-2">
                    <div class="col-md-8">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" id="modalTaskTitle" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Priority</label>
                        <select class="form-select" id="modalTaskPriority">
                            <option value="0">Low</option>
                            <option value="1">Medium</option>
                            <option value="2">High</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" id="modalTaskDescription" rows="3"></textarea>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="modalTaskStatus">
                            <option value="0">Todo</option>
                            <option value="1">In Progress</option>
                            <option value="2">Done</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Assigned user</label>
                        <select class="form-select" id="modalTaskAssignedUser"><option value="">— None —</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Group</label>
                        <select class="form-select" id="modalTaskGroup"><option value="">— None —</option></select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Labels</label>
                    <select class="form-select" id="modalTaskLabels" multiple size="4"></select>
                    <small class="text-muted">Hold Ctrl to select multiple</small>
                </div>
                <hr />
                <div class="mb-2">
                    <label class="form-label">Comments</label>
                    <div id="modalTaskCommentsList" class="border rounded p-2 mb-2" style="max-height:120px; overflow-y:auto;"></div>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="modalTaskAddComment">Add comment</button>
                </div>
                <div class="mb-2">
                    <label class="form-label">Attachments</label>
                    <div id="modalTaskAttachmentsList" class="border rounded p-2 mb-2" style="max-height:100px; overflow-y:auto;"></div>
                    <input type="file" class="d-none" id="modalTaskFileInput" />
                    <button type="button" class="btn btn-sm btn-outline-primary" id="modalTaskUploadAttachment">Upload</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalTaskSave">Save</button>
            </div>
        </div>
    </div>
</div>
