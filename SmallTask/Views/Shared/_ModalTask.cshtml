<div class="modal fade" id="modalTask" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTaskHeader">Define Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalTaskId" />
                <input type="hidden" id="modalTaskProjectId" />
                <div  style="text-align:right">
                    <label class="form-label">عنوان</label>
                    <input type="text" class="form-control" id="modalTaskTitle" style="text-align: right;" />
                </div>
                <div style="text-align:right">
                    <label class="form-label">شرح</label>
                    <div id="modalTaskDescriptionEditor" class="border rounded bg-white" style="min-height: 140px;"></div>
                </div>
                <div class="row mb-2 align-items-start">
                    <div class="col-md-5">
                        <div id="modalTaskLabelsList" class="border rounded p-2 bg-light" style="max-height: 140px; overflow-y: auto;"></div>
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex flex-column gap-2" style="text-align:right">
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm flex-grow-1" id="modalTaskStatus">
                                    <option value="0">Todo</option>
                                    <option value="1">In Progress</option>
                                    <option value="2">Done</option>
                                </select>
                                <label class="form-label mb-0 text-muted small text-nowrap" style="min-width: 6rem;">وضعیت</label>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm flex-grow-1" id="modalTaskPriority">
                                    <option value="0">Low</option>
                                    <option value="1">Medium</option>
                                    <option value="2">High</option>
                                </select>
                                <label class="form-label mb-0 text-muted small text-nowrap" style="min-width: 6rem;">اولویت</label>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm flex-grow-1" id="modalTaskGroup"><option value="">— None —</option></select>
                                <label class="form-label mb-0 text-muted small text-nowrap" style="min-width: 6rem;">گروه</label>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm flex-grow-1" id="modalTaskAssignedUser"><option value="">— None —</option></select>
                                <label class="form-label mb-0 text-muted small text-nowrap" style="min-width: 6rem;">انتساب به</label>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="mb-2">
                    <label class="form-label">Comments</label>
                    <div id="modalTaskCommentsList" class="border rounded p-2 mb-2" style="max-height:120px; overflow-y:auto;"></div>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="modalTaskAddComment">Add comment</button>
                </div>
                <div class="mb-2">
                    <label class="form-label">Attachments</label>
                    <div id="modalTaskAttachmentsList" class="border rounded p-2 mb-2" style="max-height:100px; overflow-y:auto;"></div>
                    <input type="file" class="d-none" id="modalTaskFileInput" />
                    <button type="button" class="btn btn-sm btn-outline-primary" id="modalTaskUploadAttachment">Upload</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalTaskSave">Save</button>
            </div>
        </div>
    </div>
</div>
